{
  "permissions": {
    "allow": [
      "Bash(make up)", "Bash(make down)", "Bash(make logs)", "Bash(make smoke)", "Bash(make persist)",
      "Bash(make check)", "Bash(make lambda)", "Bash(make validate)",
      "Bash(docker compose ps:*)", "Bash(docker compose logs:*)", "Bash(docker compose build:*)",
      "Bash(docker compose up:*)", "Bash(curl:*)", "Bash(jq:*)",
      "Bash(./mvnw:*)", "Bash(mvn:*)", "Bash(python3:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)",
      "Bash(sam validate:*)", "Bash(sam build:*)", "Bash(cfn-lint:*)"
    ],
    "ask": [
      "Bash(git commit:*)", "Bash(git push:*)", "Bash(sam local:*)", "Bash(make reset)"
    ],
    "deny": [
      "Read(./.env)", "Read(./samconfig.toml)", "Bash(rm -rf /*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/timelog-reminder.sh" }]
      }
    ]
  }
}
